# Copia este archivo a .env y ajusta los valores. NO subas .env al repositorio.
# Los valores de abajo son de ejemplo para desarrollo local; no son credenciales reales.

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Base de datos (PostgreSQL). Se usara en Docker Compose (Paso 8).
DB_HOST=db
DB_PORT=5432
DB_NAME=sazon_urbano
DB_USER=CAMBIAR_USUARIO
DB_PASSWORD=CAMBIAR_PASSWORD

# Opcional: URL completa. Si se define, tiene prioridad sobre DB_*.
# Sin ninguna variable de base de datos se usa un SQLite local (solo desarrollo).
# DATABASE_URL=postgresql+psycopg://CAMBIAR_USUARIO:CAMBIAR_PASSWORD@localhost:5432/sazon_urbano

# Opcional: base para correr las pruebas de persistencia también contra PostgreSQL.
# TEST_DATABASE_URL=postgresql+psycopg://CAMBIAR_USUARIO:CAMBIAR_PASSWORD@localhost:5432/sazon_test

# Datos de arranque (catálogo y demo). Poner 0 para desactivar.
# SEMBRAR_DATOS=1
