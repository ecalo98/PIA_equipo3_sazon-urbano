# Copia este archivo a .env y ajusta los valores:  cp .env.example .env
# NO subas .env al repositorio. Los valores de abajo son de ejemplo, no son credenciales reales.
# Docker Compose lee estas variables (config separada del código, 12-Factor App).

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Base de datos (PostgreSQL). Compose crea el servicio "db" con estos valores.
# Con Compose, la app usa DB_HOST=db (se fija en docker-compose.yml).
DB_HOST=localhost
DB_PORT=5432
DB_PORT_HOST=5432
DB_NAME=sazon_urbano
DB_USER=sazon
DB_PASSWORD=CAMBIAR_PASSWORD

# Opcional: URL completa. Si se define, tiene prioridad sobre DB_*.
# En Railway/Render/Fly.io la plataforma la entrega (convertir a postgresql+psycopg://).
# DATABASE_URL=postgresql+psycopg://sazon:CAMBIAR_PASSWORD@localhost:5432/sazon_urbano

# Opcional: base para correr las pruebas de persistencia también contra PostgreSQL.
# (Compose la define solo para el servicio "tests".)
# TEST_DATABASE_URL=postgresql+psycopg://sazon:CAMBIAR_PASSWORD@localhost:5432/sazon_urbano_test

# Datos de arranque (catálogo, demo y los 60 pedidos del paquete PIA). Poner 0 para desactivar.
SEMBRAR_DATOS=1
